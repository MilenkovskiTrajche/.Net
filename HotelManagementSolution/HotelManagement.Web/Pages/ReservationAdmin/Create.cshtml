@page
@model HotelManagement.Web.Pages.ReservationAdmin.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Reservation</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Reservation.CustomerId" class="control-label"></label>
                <select asp-for="Reservation.CustomerId" class ="form-control" asp-items="ViewBag.CustomerId" ></select>
            </div>
            <div class="form-group">
                <label asp-for="Reservation.RoomId" class="control-label"></label>
                <input asp-for="Reservation.RoomId" class="form-control" />
                <span asp-validation-for="Reservation.RoomId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Reservation.FromDate" class="control-label"></label>
                <input asp-for="Reservation.FromDate" class="form-control" />
                <span asp-validation-for="Reservation.FromDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Reservation.ToDate" class="control-label"></label>
                <input asp-for="Reservation.ToDate" class="form-control" />
                <span asp-validation-for="Reservation.ToDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Reservation.Adults" class="control-label"></label>
                <input asp-for="Reservation.Adults" class="form-control" />
                <span asp-validation-for="Reservation.Adults" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Reservation.Children" class="control-label"></label>
                <input asp-for="Reservation.Children" class="form-control" />
                <span asp-validation-for="Reservation.Children" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Reservation.AdditionalServices" class="control-label"></label>
                <input asp-for="Reservation.AdditionalServices" class="form-control" />
                <span asp-validation-for="Reservation.AdditionalServices" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Reservation.Price" class="control-label"></label>
                <input asp-for="Reservation.Price" class="form-control" />
                <span asp-validation-for="Reservation.Price" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Reservation.IsCanceled" /> @Html.DisplayNameFor(model => model.Reservation.IsCanceled)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
